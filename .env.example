# Copy to .env and fill in. .env is gitignored and must stay that way.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1

POSTGRES_DB=runanalizer
POSTGRES_USER=runanalizer
POSTGRES_PASSWORD=runanalizer

# Host ports only — container ports are fixed. Defaults sit off 5432/6379 so a
# local Postgres or Redis can keep running alongside this.
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- AI ----------------------------------------------------------------------
# OpenAI uses PREPAID CREDITS, not a billing account with auto-charge — which is
# the mechanism that failed on Google Cloud. Buy credit once; usage draws it down.
#
# A ChatGPT Plus/Pro subscription is a DIFFERENT PRODUCT and grants no API access.
# Credits: https://platform.openai.com/settings/organization/billing
# Key:     https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model IDs are NEVER hardcoded in application code. Operations name a tier; the
# tier resolves to an ID here, so upgrading a model is an .env edit.
# All four point at one model on purpose — split them only once the M6 eval suite
# can prove a cheaper model does the job as well. Splitting before you can measure
# is optimising blind.
AI_PROVIDER=openai
AI_LITE_MODEL=gpt-5.6-terra
AI_FAST_MODEL=gpt-5.6-terra
AI_COACH_MODEL=gpt-5.6-terra
AI_DEEP_MODEL=gpt-5.6-terra

# Second provider, added at M6 as a test that the abstraction seam is real. Its
# free tier is fine there — eval fixtures are synthetic, not your real journals.
GEMINI_API_KEY=

# --- Garmin ------------------------------------------------------------------
# No credentials here. The account is connected from the app's own UI, which
# exchanges the password for an OAuth token once and never stores the password.
# The token lives in the `garmin_tokens` docker volume.

# --- Training safety ---------------------------------------------------------
# Conservative defaults, open to review. Uncomment to override.
# MAX_WEEKLY_INCREASE_PCT=10
# MAX_HARD_SESSIONS_PER_WEEK=2
# MIN_RECOVERY_DAYS_AFTER_HARD=2
# MAX_LONG_RUN_PCT_OF_WEEK=35
# MIN_BUILD_WEEKS=4
# MIN_RUNS_FOR_PREDICTION=8
