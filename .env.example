# Copy to .env and fill in. .env is gitignored and must stay that way.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1

POSTGRES_DB=runanalizer
POSTGRES_USER=runanalizer
POSTGRES_PASSWORD=runanalizer

# Host ports only — container ports are fixed. Defaults sit off 5432/6379 so a
# local Postgres or Redis can keep running alongside this.
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- AI ----------------------------------------------------------------------
# Paid tier. The free tier's content is used to improve Google's products, and
# what gets logged here is sleep, pain, alcohol and mood. See docs/COST.md —
# the paid bill is ~30-65 rupees/month.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs are NEVER hardcoded in application code. Operations name a tier;
# the tier resolves to an ID here, so upgrading a model is an .env edit.
# Confirm current IDs at https://ai.google.dev/gemini-api/docs/models
GEMINI_LITE_MODEL=
GEMINI_FAST_MODEL=
GEMINI_COACH_MODEL=
GEMINI_DEEP_MODEL=

# Second provider, added at M6 as a test that the abstraction seam is real.
ANTHROPIC_API_KEY=
AI_PROVIDER=gemini

# --- Garmin ------------------------------------------------------------------
# No credentials here. The account is connected from the app's own UI, which
# exchanges the password for an OAuth token once and never stores the password.
# The token lives in the `garmin_tokens` docker volume.

# --- Training safety ---------------------------------------------------------
# Conservative defaults, open to review. Uncomment to override.
# MAX_WEEKLY_INCREASE_PCT=10
# MAX_HARD_SESSIONS_PER_WEEK=2
# MIN_RECOVERY_DAYS_AFTER_HARD=2
# MAX_LONG_RUN_PCT_OF_WEEK=35
# MIN_BUILD_WEEKS=4
# MIN_RUNS_FOR_PREDICTION=8
